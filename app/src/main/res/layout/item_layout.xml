<?xml version="1.0" encoding="utf-8"?>


<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:layout_marginHorizontal="10dp"
    app:cardElevation="10dp"
    app:cardCornerRadius="20dp">



<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/imageF1"
        android:contentDescription="Music Image"
        android:layout_marginStart="10dp"
        android:src="@drawable/baseline_sentiment_very_satisfied_24"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/musicTitleF1"
        android:text="Title"
        android:textSize="25sp"

        android:singleLine="true"

        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/imageF1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/musicArtistF1"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/musicArtistF1"
        android:text="Artist"
        android:textSize="14sp"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toBottomOf="@id/musicTitleF1"
        app:layout_constraintStart_toEndOf="@id/imageF1"
        app:layout_constraintBottom_toBottomOf="parent"

        />
    


</androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>