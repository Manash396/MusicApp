<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.MusicDisplay">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/titleF2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name of the song"
            android:layout_marginTop="30dp"
            android:textSize="25sp"

            android:singleLine="true"
            android:ellipsize="marquee"
            android:scrollHorizontally="true"
            android:focusable="true"
            android:textIsSelectable="true"
            android:marqueeRepeatLimit="marquee_forever"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/artistF2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/artistF2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artist"
            android:layout_marginTop="10dp"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/titleF2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

   <ImageView
       android:layout_width="0dp"
       android:layout_height="300dp"
       android:id="@+id/imageF2"
       android:src="@drawable/baseline_sentiment_very_satisfied_24"
       android:contentDescription="musicImage"
       android:layout_marginTop="40dp"
       app:layout_constraintTop_toBottomOf="@id/artistF2"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="85dp"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintTop_toBottomOf="@id/imageF2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <ImageButton
            android:id="@+id/leftPlay"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_marginTop="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="TODO"
            android:src="@drawable/baseline_arrow_circle_left_24"
            app:layout_constraintEnd_toStartOf="@id/playBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/seekBar" />

        <ImageButton
            android:id="@+id/playBtn"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_marginTop="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="TODO"
            android:src="@drawable/baseline_play_circle_24"
            app:layout_constraintEnd_toStartOf="@id/rightPlay"
            app:layout_constraintStart_toEndOf="@id/leftPlay"
            app:layout_constraintTop_toBottomOf="@id/seekBar" />

        <ImageButton
            android:id="@+id/rightPlay"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_marginTop="24dp"
            android:background="@android:color/transparent"
            android:contentDescription="TODO"
            android:src="@drawable/baseline_arrow_circle_right_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/playBtn"
            app:layout_constraintTop_toBottomOf="@id/seekBar" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>